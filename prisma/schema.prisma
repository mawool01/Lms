generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users & profiles ────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STUDENT)
  bio          String?
  avatarUrl    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Preferences
  theme              Theme   @default(SYSTEM)
  emailNotifications Boolean @default(true)
  showOnLeaderboard  Boolean @default(true)

  // Certification profile
  certReviewer Boolean @default(false)
  institution  String?
  jobTitle     String?

  coursesTaught    Course[]           @relation("CourseTeacher")
  enrollments      Enrollment[]
  completions      LessonCompletion[]
  quizAttempts     QuizAttempt[]
  submissions      Submission[]
  pointEvents      PointEvent[]
  badges           UserBadge[]
  forumThreads     ForumThread[]
  forumPosts       ForumPost[]
  messagesSent     Message[]
  participants     ConversationParticipant[]
  announcements    Announcement[]
  gradedSubmissions Submission[]      @relation("GradedBy")
  scormUploads     ScormPackage[]
  scormAttempts    ScormAttempt[]
  certApplications CertApplication[]  @relation("CertApplicant")
  certDecisions    CertApplication[]  @relation("CertDecider")
  certReviews      CertReview[]
  certMessages     CertMessage[]
  certifications   Certification[]
}

// ─── Courses & content ───────────────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  title       String
  code        String   @unique
  description String   @default("")
  coverUrl    String?
  category    String   @default("General")
  published   Boolean  @default(false)
  meetingUrl  String? // Zoom / Google Meet / Teams link for live classes
  teacherId   String
  teacher     User     @relation("CourseTeacher", fields: [teacherId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules       Module[]
  enrollments   Enrollment[]
  quizzes       Quiz[]
  assignments   Assignment[]
  forumThreads  ForumThread[]
  announcements Announcement[]
  scormPackages ScormPackage[]
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  position Int      @default(0)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
  scormPackages ScormPackage[]

  @@index([courseId])
}

/// A lesson is an ordered list of content blocks (see src/lib/blocks.ts):
/// text (markdown), image, video, chart, embed, file.
model Lesson {
  id          String             @id @default(cuid())
  moduleId    String
  title       String
  position    Int                @default(0)
  blocks      Json               @default("[]")
  points      Int                @default(10)
  module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([moduleId])
}

model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ─── Assessments ─────────────────────────────────────────────────────────────

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model Quiz {
  id           String        @id @default(cuid())
  courseId     String
  title        String
  description  String        @default("")
  passingScore Int           @default(70) // percent
  maxAttempts  Int           @default(3)  // 0 = unlimited
  weight       Int           @default(10) // weight in final course grade
  published    Boolean       @default(false)
  dueAt        DateTime?
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]
  attempts     QuizAttempt[]
  createdAt    DateTime      @default(now())

  @@index([courseId])
}

model Question {
  id       String       @id @default(cuid())
  quizId   String
  type     QuestionType @default(MULTIPLE_CHOICE)
  prompt   String
  options  String[] // for MULTIPLE_CHOICE
  answer   String // option index for MC, "true"/"false" for TF, accepted answers separated by | for short answer
  points   Int          @default(1)
  position Int          @default(0)
  quiz     Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  answers     Json // { [questionId]: string }
  score       Int // points earned
  maxScore    Int
  percent     Float
  passed      Boolean
  submittedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
}

model Assignment {
  id          String       @id @default(cuid())
  courseId    String
  title       String
  description String       @default("")
  maxPoints   Int          @default(100)
  weight      Int          @default(20)
  dueAt       DateTime?
  published   Boolean      @default(false)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]
  createdAt   DateTime     @default(now())

  @@index([courseId])
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  userId       String
  content      String
  linkUrl      String?
  grade        Int?
  feedback     String?
  gradedById   String?
  gradedAt     DateTime?
  submittedAt  DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradedBy     User?      @relation("GradedBy", fields: [gradedById], references: [id])

  @@unique([assignmentId, userId])
}

// ─── Communication ───────────────────────────────────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model ForumThread {
  id        String      @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  body      String
  pinned    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts     ForumPost[]

  @@index([courseId])
}

model ForumPost {
  id        String      @id @default(cuid())
  threadId  String
  authorId  String
  body      String
  createdAt DateTime    @default(now())
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Gamification ────────────────────────────────────────────────────────────

model PointEvent {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  // Prevents awarding the same thing twice, e.g. "lesson:<id>" or "quiz-pass:<id>"
  sourceKey String
  courseId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([courseId])
}

model Badge {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  description String
  icon        String // emoji
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// ─── SCORM ───────────────────────────────────────────────────────────────────

enum ScormVersion {
  SCORM_12
  SCORM_2004
}

enum ScormGradeMethod {
  SCORE // use the score reported by the package (falls back to completion)
  COMPLETION // full credit for completing the package
}

/// An uploaded SCORM package. Files are stored in Vercel Blob (or on local disk
/// in development) and served from this app's origin so the content can reach
/// the SCORM API on the player page.
model ScormPackage {
  id           String           @id @default(cuid())
  courseId     String
  moduleId     String?
  title        String
  description  String           @default("")
  version      ScormVersion
  launchPath   String
  launchParams String           @default("")
  masteryScore Float? // SCORM 1.2 adlcp:masteryscore (0–100)
  storage      String // "blob" | "local"
  storageBase  String // public base URL (blob) or directory (local)
  fileCount    Int
  sizeBytes    Int
  gradeMethod  ScormGradeMethod @default(SCORE)
  weight       Int              @default(20)
  points       Int              @default(50)
  published    Boolean          @default(false)
  position     Int              @default(0)
  uploadedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module       Module?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  attempts     ScormAttempt[]

  @@index([courseId])
}

/// One learner's tracking data for a package (the SCORM "cmi" data model).
model ScormAttempt {
  id               String       @id @default(cuid())
  packageId        String
  userId           String
  cmi              Json         @default("{}")
  completionStatus String       @default("not attempted") // not attempted | incomplete | completed | browsed | unknown
  successStatus    String       @default("unknown") // passed | failed | unknown
  scoreRaw         Float?
  scoreMin         Float?
  scoreMax         Float?
  scoreScaled      Float?
  percent          Float? // score derived from the package, 0–100
  overridePercent  Float? // teacher-assigned grade, 0–100
  feedback         String?
  gradedById       String?
  totalSeconds     Int          @default(0)
  sessions         Int          @default(0)
  startedAt        DateTime     @default(now())
  completedAt      DateTime?
  updatedAt        DateTime     @updatedAt
  package          ScormPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([packageId, userId])
}

// ─── ICLCA certifications ────────────────────────────────────────────────────

enum CertProgramKind {
  INDIVIDUAL // e.g. Learning Center Leadership Certification (LCLC)
  CENTER // e.g. Learning Center Certification / Learning Center of Excellence
}

enum CertApplicationType {
  INITIAL
  RENEWAL
}

enum CertApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  DENIED
  WITHDRAWN
}

enum CertRecommendation {
  APPROVE
  REVISE
  DENY
}

enum CertRating {
  DOES_NOT_MEET
  MEETS
  EXCEEDS
}

model CertProgram {
  id                    String            @id @default(cuid())
  key                   String            @unique
  name                  String
  kind                  CertProgramKind
  description           String            @default("")
  initialValidityMonths Int               @default(24)
  renewalValidityMonths Int               @default(60)
  active                Boolean           @default(true)
  position              Int               @default(0)
  createdAt             DateTime          @default(now())
  levels                CertLevel[]
  criteria              CertCriterion[]
  applications          CertApplication[]
  certifications        Certification[]
}

model CertLevel {
  id             String            @id @default(cuid())
  programId      String
  name           String
  description    String            @default("") // requirements (markdown)
  feeNote        String            @default("")
  lifetime       Boolean           @default(false)
  active         Boolean           @default(true)
  position       Int               @default(0)
  program        CertProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  criteria       CertCriterion[]
  applications   CertApplication[]
  certifications Certification[]

  @@index([programId])
}

model CertCriterion {
  id               String            @id @default(cuid())
  programId        String
  levelId          String? // null = applies to every level
  section          String            @default("")
  title            String
  guidance         String            @default("") // what evidence to provide (markdown)
  evidenceRequired Boolean           @default(true)
  active           Boolean           @default(true)
  position         Int               @default(0)
  program          CertProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  level            CertLevel?        @relation(fields: [levelId], references: [id], onDelete: Cascade)
  responses        CertResponse[]
  scores           CertReviewScore[]

  @@index([programId])
}

model CertApplication {
  id                    String                @id @default(cuid())
  programId             String
  levelId               String
  applicantId           String
  type                  CertApplicationType   @default(INITIAL)
  renewsCertificationId String?
  status                CertApplicationStatus @default(DRAFT)
  centerName            String?
  institution           String?
  statement             String                @default("")
  feePaid               Boolean               @default(false)
  feeNote               String                @default("")
  submittedAt           DateTime?
  decidedAt             DateTime?
  decidedById           String?
  decisionNote          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  program               CertProgram           @relation(fields: [programId], references: [id])
  level                 CertLevel             @relation(fields: [levelId], references: [id])
  applicant             User                  @relation("CertApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  decidedBy             User?                 @relation("CertDecider", fields: [decidedById], references: [id])
  renewsCertification   Certification?        @relation("CertRenewal", fields: [renewsCertificationId], references: [id], onDelete: SetNull)
  responses             CertResponse[]
  reviews               CertReview[]
  messages              CertMessage[]
  certification         Certification?        @relation("CertIssued")

  @@index([applicantId])
  @@index([status])
}

model CertResponse {
  id            String          @id @default(cuid())
  applicationId String
  criterionId   String
  narrative     String          @default("")
  evidence      String[]
  updatedAt     DateTime        @updatedAt
  application   CertApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  criterion     CertCriterion   @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, criterionId])
}

model CertReview {
  id             String              @id @default(cuid())
  applicationId  String
  reviewerId     String
  recommendation CertRecommendation?
  comments       String              @default("")
  submittedAt    DateTime?
  assignedAt     DateTime            @default(now())
  application    CertApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer       User                @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  scores         CertReviewScore[]

  @@unique([applicationId, reviewerId])
}

model CertReviewScore {
  id          String        @id @default(cuid())
  reviewId    String
  criterionId String
  rating      CertRating
  comment     String        @default("")
  review      CertReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion   CertCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([reviewId, criterionId])
}

model CertMessage {
  id            String          @id @default(cuid())
  applicationId String
  authorId      String
  body          String
  internal      Boolean         @default(false) // visible to reviewers and admins only
  createdAt     DateTime        @default(now())
  application   CertApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Certification {
  id              String            @id @default(cuid())
  code            String            @unique // public verification code
  programId       String
  levelId         String
  holderId        String?
  holderName      String
  holderEmail     String?
  centerName      String?
  institution     String?
  issuedAt        DateTime
  expiresAt       DateTime? // null = lifetime
  revokedAt       DateTime?
  revokeReason    String?
  isRenewal       Boolean           @default(false)
  showInDirectory Boolean           @default(true)
  reminderStage   Int               @default(0) // smallest "days before expiry" reminder already sent (0 = none)
  applicationId   String?           @unique
  createdAt       DateTime          @default(now())
  program         CertProgram       @relation(fields: [programId], references: [id])
  level           CertLevel         @relation(fields: [levelId], references: [id])
  holder          User?             @relation(fields: [holderId], references: [id], onDelete: SetNull)
  application     CertApplication?  @relation("CertIssued", fields: [applicationId], references: [id], onDelete: SetNull)
  renewals        CertApplication[] @relation("CertRenewal")

  @@index([holderId])
  @@index([expiresAt])
}
