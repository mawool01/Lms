# Postgres connection (Vercel Postgres / Neon / Supabase).
# DATABASE_URL may be a pooled connection; DIRECT_URL must be a direct (non-pooled) connection for migrations.
# On Vercel with the Neon integration you can skip DIRECT_URL: the build falls back to DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: allow anyone to create a student account from the sign-up page (default: true)
ALLOW_SIGNUP="true"

# Optional: daily certification expiry reminders (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""

# Optional: certification emails via Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional: public site address used in emails and certificates (defaults to the Vercel production URL)
APP_URL=""

# Optional: "Sign in with Wild Apricot" (Apps → Authorized applications → Server application, with Wild Apricot login ticked)
# Set APP_URL above as well: the sign-in redirect is built from it, and that exact
# address must be listed under the application's "Trusted redirect domains".
WILDAPRICOT_URL=""
WILDAPRICOT_CLIENT_ID=""
WILDAPRICOT_CLIENT_SECRET=""

# Optional: enroll people from Wild Apricot events, member groups and membership levels.
# Wild Apricot admin view → Apps → Authorized applications → your Server application:
# the API key is shown UNDER THE APPLICATION NAME, above the client id and secret.
# That application needs access to events and contacts ("Wild Apricot login" alone
# can't read registrations or groups). Enables the nightly job, Admin → Wild Apricot,
# and linking from a course's Settings tab.
WILDAPRICOT_API_KEY=""
# Optional: only needed if one API key covers more than one Wild Apricot account
WILDAPRICOT_ACCOUNT_ID=""
# Optional: also match Wild Apricot people to LMS accounts by email address when they
# have never signed in with Wild Apricot (default true). An email match only enrolls
# someone — it never links the accounts. Set to "false" to require a linked account.
WILDAPRICOT_SYNC_EMAIL_MATCH="true"
